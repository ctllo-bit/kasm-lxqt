#!/bin/bash
LOG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/info.log"
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 安装KasmVNC
sudo apt install /var/apps/kasm-lxqt/target/server/kasmvncserver_bookworm_*.deb -y
log_msg "[INFO] KasmVNC Server 版本: $(dpkg-query -W -f='${Version}' kasmvncserver 2>/dev/null)"

if [ "$EUID" -eq 0 ]; then
    exec runuser -u "${CURRENT_USER}" -- "$0" "$@"
fi

log_msg "现在用户: $(whoami)" 
mkdir -p ~/.vnc

# 创建Kasm用户
KASM_PASS="123456"
echo -e "${KASM_PASS}\n${KASM_PASS}\n" | kasmvncpasswd -u $USER -ow

# 生成LXQt配置
cat > ~/.vnc/xstartup <<'EOF'
#!/bin/sh

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=LXQt
export XDG_CONFIG_DIRS=/etc/xdg/xdg-LXQt:/etc/xdg

exec startlxqt
EOF
chmod +x ~/.vnc/xstartup

# 创建kasm配置文件
cat > "$HOME/.vnc/kasmvnc.yaml" <<EOF
desktop:
  resolution:
    width: 1920
    height: 1080
  allow_resize: true

network:
  protocol: http
  interface: 0.0.0.0
  websocket_port: 8088
  use_ipv4: true
  use_ipv6: false

logging:
  log_writer_name: all
  log_dest: logfile
  level: 100
EOF


exit 0