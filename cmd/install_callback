#!/bin/bash
LOG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/info.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 安装KasmVNC
sudo apt install -y /var/apps/kasm-lxqt/target/server/kasmvncserver_bookworm_*.deb

REMOTE_HOME="/home/remote-desktop"
log_msg "[INFO] 配置KasmVNC的Systemd服务..."
sudo tee "/etc/systemd/system/kasmvnc.service" > /dev/null <<EOF
[Unit]
Description=KasmVNC Server
After=network.target

[Service]
Type=forking
User=1000
Group=Users
Restart=always
RestartSec=3

Environment=HOME=${REMOTE_HOME}
Environment=DISPLAY=:1

ExecStart=/usr/bin/kasmvncserver
ExecStop=/usr/bin/kasmvncserver -kill

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

log_msg "正在创建 proxy 服务..."
sudo tee "/etc/systemd/system/kasm-client.service" > /dev/null <<EOF
[Unit]
Description=kasm-client
After=kasmvnc.service
Requires=kasmvnc.service

[Service]
Type=simple
User=1000
Group=Users
Restart=always
RestartSec=3

ExecStart=${TRIM_APPDEST}/server/kclient 

[Install]
WantedBy=multi-user.target
EOF

# 开机自启 Kasm 
sudo systemctl daemon-reload
sudo systemctl enable kasmvnc.service
sudo systemctl enable kasm-client.service

# 切换用户
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ "$EUID" -eq 0 ]; then
    exec runuser -u "${CURRENT_USER}" -- "$0" "$@"
fi

# 配置 Kasm 账号
rm -f "${REMOTE_HOME}/.kasmpasswd"
echo -e "${wizard_password}\n${wizard_password}\n" | kasmvncpasswd -u "${wizard_username}" -ow
mv ~/.kasmpasswd "${REMOTE_HOME}"


# 生成LXQt配置
mkdir -p "${REMOTE_HOME}/.vnc"
cat > "${REMOTE_HOME}/.vnc/xstartup" <<EOF
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

export PULSE_SERVER=unix:/run/user/1000/pulse/native
exec dbus-run-session -- startlxqt
EOF
chmod +x "${REMOTE_HOME}/.vnc/xstartup"

# 添加标记
touch "${REMOTE_HOME}/.vnc/.de-was-selected"

exit 0