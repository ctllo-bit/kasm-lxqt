#!/bin/bash
LOG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/info.log"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 安装KasmVNC
sudo apt install -y /var/apps/kasm-lxqt/target/server/kasmvncserver_bookworm_*.deb

REMOTE_HOME="/home/remote-desktop"
log_msg "[INFO] 配置KasmVNC的Systemd服务..."
sudo tee "/etc/systemd/system/kasmvnc.service" > /dev/null <<EOF
[Unit]
Description=KasmVNC Server
After=network.target
# 关键：将此服务的生命周期绑定到 kasm-client
PartOf=kasm-client.service

[Service]
Type=forking
User=1000
Group=Users

Environment=HOME=${REMOTE_HOME}
Environment=DISPLAY=:1

ExecStart=/usr/bin/kasmvncserver
ExecStop=/usr/bin/kasmvncserver -kill

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

log_msg "正在创建 kasm-pulseaudio 服务..."
sudo tee "/etc/systemd/system/kasm-pulseaudio.service" > /dev/null <<EOF
[Unit]
Description=KasmVNC Remote PulseAudio

Before=kasmvnc.service
# 关键：将此服务的生命周期绑定到 kasm-client
PartOf=kasm-client.service

[Service]
Type=simple
User=1000
Group=Users

Environment=HOME=${REMOTE_HOME}
Environment=XDG_RUNTIME_DIR=/run/user/1000/remote-desktop
Environment=PULSE_RUNTIME_PATH=/run/user/1000/remote-desktop/pulse
Environment=PULSE_STATE_PATH=${REMOTE_HOME}/.config/pulse

ExecStartPre=/bin/mkdir -p /run/user/1000/remote-desktop/pulse
ExecStartPre=/bin/chown 1000:Users /run/user/1000/remote-desktop/pulse

ExecStart=/usr/bin/pulseaudio --daemonize=no --exit-idle-time=-1

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
EOF


log_msg "正在创建 proxy 服务..."
sudo tee "/etc/systemd/system/kasm-client.service" > /dev/null <<EOF
[Unit]
Description=kasm-client
# 关键：启动 client 时同时要求启动 vnc 和 pulseaudio
After=kasmvnc.service kasm-pulseaudio.service
Requires=kasmvnc.service kasm-pulseaudio.service

[Service]
Type=simple
User=1000
Group=Users
Restart=always
RestartSec=3

ExecStart=${TRIM_APPDEST}/server/kclient 

[Install]
WantedBy=multi-user.target
EOF

# 开机自启 Kasm 
sudo systemctl daemon-reload
sudo systemctl enable kasm-client.service

# 切换用户
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ "$EUID" -eq 0 ]; then
    exec runuser -u "${CURRENT_USER}" -- "$0" "$@"
fi

# 为远程桌面单独创建 Runtime
mkdir "/run/user/1000/remote-desktop"

# 配置 Kasm 账号
rm -f "${REMOTE_HOME}/.kasmpasswd"
echo -e "${wizard_password}\n${wizard_password}\n" | kasmvncpasswd -u "${wizard_username}" -ow
mv ~/.kasmpasswd "${REMOTE_HOME}"

# 生成LXQt配置
mkdir "${REMOTE_HOME}/.vnc"
cat > "${REMOTE_HOME}/.vnc/xstartup" <<EOF
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

export XDG_RUNTIME_DIR=/run/user/1000/remote-desktop
export PULSE_SERVER=unix:/run/user/1000/remote-desktop/pulse/native
exec dbus-run-session -- startlxqt
EOF
chmod +x "${REMOTE_HOME}/.vnc/xstartup"

# 添加标记
touch "${REMOTE_HOME}/.vnc/.de-was-selected"

# 配置 PulseAudio
mkdir -p "${REMOTE_HOME}/.config/pulse"
cat > "${REMOTE_HOME}/.config/pulse/default.pa" <<'EOF'
.include /etc/pulse/default.pa

load-module module-null-sink sink_name=kasm_sink sink_properties=device.description=KasmAudio
load-module module-remap-source source_name=virtmic master=kasm_sink.monitor

set-default-sink kasm_sink
set-default-source virtmic
EOF
systemctl --user enable --now pulseaudio.service

# SSL cert
rm -f "${REMOTE_HOME}/.vnc/self.key" "${REMOTE_HOME}/.vnc/self.pem"
openssl req -x509 \
  -nodes \
  -days 3650 \
  -newkey rsa:2048 \
  -keyout "${REMOTE_HOME}/.vnc/self.key" \
  -out "${REMOTE_HOME}/.vnc/self.pem" \
  -subj "/C=US/ST=VA/L=None/O=None/OU=DoFu/CN=kasm/emailAddress=none@none.none"
chmod 600 "${REMOTE_HOME}/.vnc/self.key"

# 创建kasm配置文件
cat > "${REMOTE_HOME}/.vnc/kasmvnc.yaml" <<EOF
desktop:
  resolution:
    width: 1920
    height: 1080
  allow_resize: true

network:
  protocol: http
  interface: 127.0.0.1
  websocket_port: 6901
  use_ipv4: true
  use_ipv6: false

  ssl:
    pem_certificate: /etc/ssl/certs/ssl-cert-snakeoil.pem
    pem_key: /etc/ssl/private/ssl-cert-snakeoil.key
    require_ssl: true

server:
  http:
    headers:
      - Cross-Origin-Embedder-Policy=require-corp
      - Cross-Origin-Opener-Policy=same-origin
    httpd_directory: /usr/share/kasmvnc/www
  advanced:
    kasm_password_file: ${REMOTE_HOME}/.kasmpasswd

logging:
  log_writer_name: all
  log_dest: logfile
  level: 100
EOF

# 创建 kclient 配置文件
cat > "${REMOTE_HOME}/.vnc/kclient.yaml" <<EOF
subfolder: "/"
title: "KasmVNC Client"

fm_home: "$REMOTE_HOME"

vnc:
  port: ${wizard_port}
  proxy_target: "https://127.0.0.1:6901"

ssl:
  pem_certificate: $REMOTE_HOME/.vnc/self.pem
  pem_key: $REMOTE_HOME/.vnc/self.key

audio:
  device: "kasm_sink.monitor"
  server: "/run/user/1000/remote-desktop/pulse/native"

mic_socket: "/defaults/mic.sock"

max_upload_size: 200000000
EOF


exit 0