#!/bin/bash
LOG_FILE="${TRIM_DATA_SHARE_PATHS%%:*}/info.log"
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

# 安装KasmVNC
sudo apt install /var/apps/kasm-lxqt/target/server/kasmvncserver_bookworm_*.deb -y
log_msg "[INFO] KasmVNC Server 版本: $(dpkg-query -W -f='${Version}' kasmvncserver 2>/dev/null)"

log_msg "[INFO] 配置KasmVNC的Systemd服务..."
sudo tee "/etc/systemd/system/kasmvnc.service" > /dev/null <<EOF
[Unit]
Description=KasmVNC Server
After=network.target

[Service]
Type=forking
User=1000
Group=1001

Environment=DISPLAY=:1
ExecStart=/usr/bin/kasmvncserver
ExecStop=/usr/bin/kasmvncserver -kill

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

# 启动服务
sudo systemctl daemon-reload
sudo systemctl enable kasmvnc.service

if [ "$EUID" -eq 0 ]; then
    exec runuser -u "${CURRENT_USER}" -- "$0" "$@"
fi

log_msg "现在用户: $(whoami)" 
mkdir -p ~/.vnc

# 创建Kasm用户
KASM_PASS="123456"
echo -e "${KASM_PASS}\n${KASM_PASS}\n" | kasmvncpasswd -u $USER -ow

# 创建kasm配置文件
cat > "$HOME/.vnc/kasmvnc.yaml" <<EOF
desktop:
  resolution:
    width: 1920
    height: 1080
  allow_resize: true

network:
  protocol: http
  interface: 0.0.0.0
  websocket_port: 8088
  use_ipv4: true
  use_ipv6: false

logging:
  log_writer_name: all
  log_dest: logfile
  level: 100
EOF

# 启动桌面
kasmvncserver -select-de lxqt
kasmvncserver -kill :1

# 生成LXQt配置
cat > ~/.vnc/xstartup <<'EOF'
#!/bin/sh

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

exec startlxqt
EOF
chmod +x ~/.vnc/xstartup      
exit 0