#!/bin/bash
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ -z "${CURRENT_USER}" ]; then
    exit 1
fi

# 配置本地用户
HOME_DIR="/home/${CURRENT_USER}"
sudo mkdir "${HOME_DIR}" "/home/remote-desktop"
sudo chown -R 1000:1001 "${HOME_DIR}" "/home/remote-desktop"
sudo chmod 700 "${HOME_DIR}" "/home/remote-desktop"

# SSL 证书访问权限
sudo adduser "${CURRENT_USER}" ssl-cert

# 安装桌面
sudo apt update
sudo apt install -y dbus-x11 libglib2.0-bin xfce4 xfce4-goodies

# 当前用户开启 linger
sudo loginctl enable-linger "${CURRENT_USER}"

# 配置中文字体
sudo apt install -y locales fonts-noto-cjk fonts-wqy-zenhei
sudo sed -i 's/^# *zh_CN.UTF-8 UTF-8/zh_CN.UTF-8 UTF-8/' /etc/locale.gen
sudo locale-gen
sudo update-locale LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh LC_ALL=zh_CN.UTF-8

# 启用 LightDM
sudo systemctl start lightdm

exit 0