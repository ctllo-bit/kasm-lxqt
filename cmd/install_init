#!/bin/bash
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ -z "${CURRENT_USER}" ]; then
    exit 1
fi

HOME_DIR="/home/${CURRENT_USER}"
# 新建家目录
sudo mkdir "${HOME_DIR}"
sudo chown -R 1000:1001 "${HOME_DIR}"
sudo chmod 700 "${HOME_DIR}"

# 将当前用户加入 ssl-cert 组以管理证书
sudo adduser ${CURRENT_USER} ssl-cert

sudo apt update
# 安装 LXQt 桌面
sudo apt install -y dbus-x11 lxqt-core lightdm lightdm-gtk-greeter

# 配置 PulseAudio
sudo cat > "/etc/pulse/default.pa.d/kasm.pa" <<'EOF'
load-module module-null-sink sink_name=kasm_sink sink_properties=device.description=KasmAudio
load-module module-remap-source source_name=virtmic master=kasm_sink.monitor

set-default-sink kasm_sink
set-default-source virtmic
EOF

# 启用 PulseAudio
sudo -u ${CURRENT_USER} XDG_RUNTIME_DIR=/run/user/1000 systemctl --user restart pulseaudio
# 启用 LightDM
sudo systemctl restart lightdm


exit 0