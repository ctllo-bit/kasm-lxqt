#!/bin/bash
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ -z "${CURRENT_USER}" ]; then
    exit 1
fi

HOME_DIR="/home/${CURRENT_USER}"
# 新建家目录
sudo mkdir "${HOME_DIR}"
sudo chown -R 1000:1001 "${HOME_DIR}"
sudo chmod 700 "${HOME_DIR}"

# 将当前用户加入 ssl-cert 组以管理证书
sudo adduser ${CURRENT_USER} ssl-cert

# 安装 LXQt 桌面管理器
sudo apt update
sudo apt install lxqt-core lxqt-qtplugin lxqt-powermanagement -y

exit 0