#!/bin/bash
CURRENT_USER=$(getent passwd 1000 | cut -d: -f1)
if [ -z "${CURRENT_USER}" ]; then
    exit 1
fi

HOME_DIR="/home/${CURRENT_USER}"
# 新建家目录
sudo mkdir "${HOME_DIR}"
sudo chown -R 1000:1001 "${HOME_DIR}"
sudo chmod 700 "${HOME_DIR}"

# 将当前用户加入 ssl-cert 组以管理证书
sudo adduser ${CURRENT_USER} ssl-cert

# 安装 LXQt 桌面管理器
sudo apt update
sudo apt install -y dbus-x11 lxqt-core

# 配置中文环境
sudo apt install -y locales fonts-noto-cjk fonts-wqy-zenhei
sudo sed -i '/^# zh_CN.UTF-8 UTF-8/s/^# //' /etc/locale.gen
sudo locale-gen
sudo update-locale LANG=zh_CN.UTF-8

exit 0